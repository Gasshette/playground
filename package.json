{
  "name": "@gasshette/playground",
  "version": "2.0.2",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "homepage": "https://gasshette.github.io/playground",
  "main": "./dist/index.umd.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite --open",
    "predeploy": "npm run build:demo",
    "deploy": "gh-pages -d build",
    "build": "tsc --p ./tsconfig.build.json && vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/lodash.debounce": "^4.0.9",
    "@uiw/codemirror-extensions-color": "^4.24.0",
    "@uiw/react-codemirror": "^4.22.2",
    "color": "^5.0.0",
    "lodash.debounce": "^4.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-tiny-popover": "^8.1.6",
    "sass": "^1.77.6",
    "thememirror": "^2.0.1",
    "use-debounce": "^10.0.1"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "prepublishOnly": "npm run build",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "gh-pages": "^6.3.0",
    "typescript": "^5.2.2",
    "vite": "^5.3.1",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-lib-inject-css": "^2.1.1"
  },
  "description": "A customizable playground component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gasshette/playground.git"
  },
  "keywords": [
    "react",
    "playground",
    "customizable",
    "modular"
  ],
  "author": "Gasshette",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Gasshette/playground/issues"
  }
}
